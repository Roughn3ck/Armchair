# Environment variables and paths
# Copy to .env and fill in values

# Ollama LLM endpoint
LLM_API_HOST=localhost
LLM_API_PORT=11434
LLM_API_PATH=/api/chat

# Whisper model
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda

# TTS voice
TTS_VOICE_DEFAULT=af_nicole

# Audio capture
AUDIO_FILE=/mnt/b/cochran_audio.raw
CHUNK_SECONDS=4
OVERLAP_SECONDS=1
SILENCE_THRESHOLD=3

# LLM
LLM_MODEL_DEFAULT=deepseek-v3.2:cloud
LLM_MAX_TOKENS=60
LLM_TEMPERATURE=0.7
THINK_INTERVAL=4