# Environment variables and paths
# Copy to .env and fill in values
# API keys live here (gitignored) — NOT in agent_config.json

# ===== LLM Providers (v2.3 — one per active provider) =====
# Ollama (local, default)
LLM_PROVIDER=ollama
LLM_API_HOST=localhost
LLM_API_PORT=11434
LLM_API_PATH=/api/chat
LLM_MODEL_DEFAULT=deepseek-v4-flash:cloud

# OpenAI (uncomment to use)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Anthropic (uncomment to use)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# TokenRa (uncomment to use)
# TOKENRA_API_KEY=...
# TOKENRA_MODEL=...

# OpenRouter (uncomment to use)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=...

# ===== Whisper (STT) =====
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
# Vocab biasing: primes the decoder with house vocabulary (wake name + pack
# words) so they transcribe reliably. Keep it short — long prompts lose
# influence. Set to empty to disable.
WHISPER_INITIAL_PROMPT=Agricola. The pack: Muska, Kimi, Slater, Aria, Cochran, Sagan, Garrison, Oyola, Deschamps. Voicemeeter, piper, FishTank, ColdStack, Sentinel.
# Endpoint: ms of silence after the last voiced frame that finalizes an
# utterance (Silero hangover). 0 = legacy behavior (first silent 32 ms frame
# ends speech) — no change; raise it to trade endpoint snappiness for fewer
# mid-utterance cuts. Tune empirically via [METRIC] endpoint_delay_ms.
ENDPOINT_SILENCE_MS=0

# ===== TTS =====
TTS_ENGINE_DEFAULT=piper
TTS_VOICE_DEFAULT=en_GB-alan-medium

# ===== HuggingFace (pyannote) =====
HF_TOKEN=

# ===== Audio Capture (platform-specific) =====
AUDIO_FILE=/mnt/b/armchair_audio.raw

# ===== LLM Options =====
LLM_MAX_TOKENS=150
LLM_TEMPERATURE=0.7
THINK_INTERVAL=4

# ===== Conversation =====
# Follow-up window: after the agent is addressed by name once, replies keep
# flowing without the name until this many seconds pass without an exchange.
FOLLOWUP_TIMEOUT=60
# Echo gate: while the agent's TTS plays on the speakers, mic input is
# discarded so the agent can't hear itself (half-duplex — no barge-in while
# it speaks). Set to 0 only when using headphones on A1 (no acoustic loop)
# to restore full interruption.
ECHO_GATE=1

# ===== Identity curation (voice-agent context budget) =====
# Voice persona gets a curated system prompt instead of the full agent workspace.
# T1 always: SOUL/IDENTITY/USER. T2: PROJECTS/TEAM-ROSTER/NEXT + recent memory.
# T3 never: TOOLS/DIRECTORY/AGENTS/SOCIAL-ACCOUNTS/HEARTBEAT (agent-ops docs).
IDENTITY_MAX_CHARS=48000
IDENTITY_RECENT_DAYS=14
IDENTITY_SKIP_FILES=
