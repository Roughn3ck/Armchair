# Environment variables and paths
# Copy to .env and fill in values
# API keys live here (gitignored) — NOT in agent_config.json

# ===== LLM Providers (v2.3 — one per active provider) =====
# Ollama (local, default)
LLM_PROVIDER=ollama
LLM_API_HOST=localhost
LLM_API_PORT=11434
LLM_API_PATH=/api/chat
LLM_MODEL_DEFAULT=deepseek-v4-flash:cloud

# OpenAI (uncomment to use)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Anthropic (uncomment to use)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# TokenRa (uncomment to use)
# TOKENRA_API_KEY=...
# TOKENRA_MODEL=...

# OpenRouter (uncomment to use)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=...

# ===== Whisper (STT) =====
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16

# ===== TTS =====
TTS_ENGINE_DEFAULT=piper
TTS_VOICE_DEFAULT=en_GB-alan-medium

# ===== HuggingFace (pyannote) =====
HF_TOKEN=

# ===== Audio Capture (platform-specific) =====
AUDIO_FILE=/mnt/b/armchair_audio.raw

# ===== LLM Options =====
LLM_MAX_TOKENS=150
LLM_TEMPERATURE=0.7
THINK_INTERVAL=4

# ===== Identity curation (voice-agent context budget) =====
# Voice persona gets a curated system prompt instead of the full agent workspace.
# T1 always: SOUL/IDENTITY/USER. T2: PROJECTS/TEAM-ROSTER/NEXT + recent memory.
# T3 never: TOOLS/DIRECTORY/AGENTS/SOCIAL-ACCOUNTS/HEARTBEAT (agent-ops docs).
IDENTITY_MAX_CHARS=48000
IDENTITY_RECENT_DAYS=14
IDENTITY_SKIP_FILES=
